# ======================================================================================
# Consultation Hub backend — every setting. Set these as Railway variables (never paste keys into chat).
# NEEDS = the developer must supply a real value before launch.
# ======================================================================================

# ---- Core ----------------------------------------------------------------------------
APP_ENV=production                    # production | development | test
BRAND_NAME=Consultation Hub           # shown in WhatsApp/SMS/checkout; the web brand is frontend/src/brand.js
PUBLIC_BASE_URL=https://example.com   # NEEDS: the live URL
MONGO_URL=mongodb+srv://...           # NEEDS: MongoDB Atlas connection string (a NEW database, not the current hub's)
DB_NAME=consultation_hub
JWT_SECRET=                           # NEEDS: long random string (python -c "import secrets;print(secrets.token_urlsafe(48))")
COOKIE_SECURE=true                    # false only for local http
COOKIE_SAMESITE=lax
CORS_ORIGINS=                         # only if the frontend is served from another origin
LOG_LEVEL=INFO
SENTRY_DSN=                           # optional
SENTRY_TRACES_SAMPLE_RATE=0.05

# ---- Admin ---------------------------------------------------------------------------
ADMIN_PHONES=+91XXXXXXXXXX            # NEEDS: team mobile numbers (comma-separated) that get admin on OTP login
ADMIN_EMAIL=                          # optional email + password team login (created on startup)
ADMIN_PASSWORD=

# ---- Jobs ----------------------------------------------------------------------------
INPROCESS_SCHEDULER=true              # the app runs its own daily jobs (L1 restart after L2)
INGEST_KEY=                           # only if an external cron calls POST /api/jobs/tick (X-Ingest-Key)

# ---- QA (never in production) ---------------------------------------------------------
QA_MODE=false                         # true: all vendors fake, sample content, /api/qa/login, OTP shown on screen

# ---- Login codes (OTP) ----------------------------------------------------------------
MSG91_AUTH_KEY=                       # NEEDS (SMS): MSG91 auth key
MSG91_OTP_TEMPLATE_ID=                # NEEDS (SMS): DLT-approved OTP template id
AISENSY_API_KEY=                      # NEEDS for WhatsApp OTP: AiSensy API key
AISENSY_OTP_CAMPAIGN=otp              # AiSensy API campaign on the approved Authentication template
OTP_PROVIDER_MODE=live                # live | console (console = dev only)

# ---- WhatsApp messages (optional; the in-app inbox always works) ----------------------
# Turn on in Admin › Switches › WhatsApp alerts. One AiSensy campaign per message kind, named alert_<kind>:
#   alert_weekly_case  alert_group_session  alert_call  alert_recap  alert_bootcamp  alert_support
#   alert_akshat_ai  alert_progress  alert_proposal  alert_diagnostic  alert_site_lead  alert_l2  alert_billing  alert_system
# A missing campaign only skips the WhatsApp copy. Use another name with AISENSY_CAMPAIGN_<KIND>=..., e.g.:
AISENSY_CAMPAIGN_GROUP_SESSION=
AISENSY_CAMPAIGN_WEEKLY_CASE=

# ---- Payments (Razorpay Subscriptions) -------------------------------------------------
RAZORPAY_KEY_ID=                      # NEEDS
RAZORPAY_KEY_SECRET=                  # NEEDS
RAZORPAY_WEBHOOK_SECRET=              # NEEDS: webhook → <PUBLIC_BASE_URL>/api/billing/razorpay/webhook
RAZORPAY_PLAN_MEMBER_MONTHLY=         # NEEDS: Razorpay plan id at ₹2,359/month (₹1,999 + 18% GST)
RAZORPAY_PLAN_MEMBER_YEARLY=          # NEEDS: Razorpay plan id at ₹23,600/year (₹20,000 + 18% GST)
RAZORPAY_PLAN_L1_MONTHLY=             # NEEDS: Razorpay plan id at ₹5,900/month (₹5,000 + 18% GST)

# ---- AI (Anthropic): every text tool --------------------------------------------------
ANTHROPIC_API_KEY=                    # NEEDS
LLM_MODEL_FAST=claude-haiku-5-5
LLM_MODEL_STRONG=claude-sonnet-5-5
LLM_MODEL_VISION=claude-opus-5-5      # reading screenshots / images
LLM_MAX_CONCURRENCY=32                # AI calls at once per worker; size against your Anthropic rate limit
LLM_TIMEOUT_S=45                      # long answers (decks, proposals, chats) get 120–150 s automatically

# ---- Web search + page reading: Meeting Brief news, weekly case, Research Notebook, Radar, Insight Pack, Call Prep --
# Runs on the same ANTHROPIC_API_KEY (server-side web search + web fetch tools). Nothing to set here.
# Web search costs $10 per 1,000 searches plus tokens; an org admin can switch it off in the Anthropic Console.
# SEARCH_MODE=off turns live news off without touching the AI.

# ---- Presentation Builder (Gamma) ------------------------------------------------------
GAMMA_API_KEY=                        # NEEDS
GAMMA_IMAGE_SOURCE=pictographic       # images inside decks

# ---- Google Gemini: Pitch Practice video analysis + audio (Listen mode, recaps and packs read aloud,
#      Story Bank voice notes). One key for both. ------------------------------------------
GEMINI_API_KEY=                       # NEEDS
GEMINI_MODEL=gemini-3.8-flash         # video analysis
GEMINI_TTS_MODEL=gemini-3.8-flash-tts # text to speech (cheaper: gemini-3.8-flash-lite-tts)
GEMINI_TTS_VOICE=Iapetus              # calm, clear prebuilt voice; or a voice id from the Extended Voice Library
GEMINI_STT_MODEL=gemini-3.8-flash     # speech to text
GEMINI_POLL_MAX_S=300                 # longest wait for the video to be processed
PITCH_MAX_CONCURRENCY=4               # videos analysed at once per worker (each up to 100 MB on disk while it runs)
PITCH_TMP_DIR=                        # blank = system temp; the video is deleted after analysis

# ---- Website Builder ------------------------------------------------------------------
SITES_DOMAIN=                         # e.g. sites.example.com with a wildcard DNS *.sites.example.com → Railway.
                                      # Blank = sites open at <PUBLIC_BASE_URL>/s/<name>

# ---- Vendor switches (live | fake | off). Unset = live when keys are present. -------------
# RAZORPAY_MODE= AISENSY_MODE= MSG91_MODE= ANTHROPIC_MODE= SEARCH_MODE= GAMMA_MODE= GEMINI_MODE=
# (fake is refused in production; off = the tool shows "paused")
